generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}


enum UserRole {
  DONOR
  PARTNER
  SPONSOR
  ADMIN
}

enum InstitutionType {
  ORFELINAT
  CASA_DE_COPII
  CENTRU_PLASAMENT
  ONG
  FUNDATIE
  ALTUL
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Application fields (not settable via client auth input)
  role          UserRole  @default(DONOR)
  firstName     String?
  lastName      String?
  lastLoginAt   DateTime?

  institution   Institution? @relation(fields: [institutionId], references: [id])
  institutionId String?

  sponsorProfile SponsorProfile?
  sessions      Session[]
  accounts      Account[]

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Institution {
  id             String   @id @default(uuid())
  // Internal/Legal
  name           String   
  cui            String?  @unique
  institutionType InstitutionType @default(ALTUL)
  
  // Public Profile
  slug             String?  @unique
  publicName       String?  // If null, fallback to 'name'
  descriptionPublic String?
  logoUrl          String?
  website          String?

  verified       Boolean  @default(false)
  
  county         String   
  city           String
  addressPrivate String?  
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  representativeRole String?
  
  users          User[]
  scrisori       Scrisoare[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Campaign {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  descriptionShort String?
  startsAt         DateTime
  endsAt           DateTime?
  status           String   @default("DRAFT")
  category         String?  
  scrisori         Scrisoare[]
  matchingRules    MatchingRule[]
  createdAt        DateTime @default(now())
}

model Sponsor {
  id          String   @id @default(uuid())
  name        String
  website     String?
  logoUrl     String?
  matchingRules MatchingRule[]
  donations     Donation[]
  createdAt   DateTime @default(now())
}

model MatchingRule {
  id                  String   @id @default(uuid())
  sponsor             Sponsor  @relation(fields: [sponsorId], references: [id])
  sponsorId           String
  campaign            Campaign? @relation(fields: [campaignId], references: [id])
  campaignId          String?
  matchType           String   @default("PERCENT_100") 
  maxMatchTotal       Decimal 
  maxMatchPerDonation Decimal? 
  currentMatchTotal   Decimal  @default(0) 
  active              Boolean  @default(true)
  startsAt            DateTime
  endsAt              DateTime?
  donations           Donation[]
  createdAt           DateTime @default(now())
  @@index([sponsorId])
  @@index([campaignId])
}

enum MediaType {
  IMAGE
  VIDEO
}

model Scrisoare {
  id              String          @id @default(uuid())
  publicCode      String          @unique 
  slug            String          @unique @default(cuid()) 
  
  childFirstName  String
  childAge        Int
  childGender     String?
  childStory      String?         
  items           String?         
  originalImgUrl  String          
  mediaType       MediaType       @default(IMAGE)
  wishList        String          
  category        String          @default("ALTCEVA")

  targetAmount            Decimal
  submittedTargetAmount   Decimal         @default(0)
  approvedTargetAmount    Decimal?
  collectedAmount         Decimal         @default(0)
  
  // draft | pending_review | approved | rejected | fulfilled | externally_fulfilled | archived
  status                  String          @default("NOU") 
  moderationStatus        String          @default("draft") 
  rejectionReason         String?
  partnerNotes            String?
  adminNotes              String?
  proofApproved           Boolean         @default(false)

  approvedAt              DateTime?
  approvedById            String?
  rejectedAt              DateTime?
  rejectedById            String?

  // External fulfillment → general fund
  externallyFulfilledAt   DateTime?
  externallyFulfilledById String?
  externalFulfillmentNote String?
  
  childLastName           String          
  childCnpHash            String?          
  
  institution             Institution     @relation(fields: [institutionId], references: [id])
  institutionId           String

  campaign                Campaign?       @relation(fields: [campaignId], references: [id])
  campaignId              String?
  
  donations               Donation[]
  reservations            Reservation[]
  proofs                  ProofMedia[]
  fulfillmentClaims       FulfillmentClaim[]
  updates                 Update[]
  fundTransfersFrom       FundTransaction[] @relation("FundSourceLetter")
  fundTransfersTo         FundTransaction[] @relation("FundDestinationLetter")

  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([status])
  @@index([moderationStatus]) 
  @@index([institutionId])
  @@index([category])
  @@index([slug])
  @@index([campaignId])
}

model Donation {
  id                   String         @id @default(uuid())
  stripePaymentIntentId String?       @unique
  stripeSessionId      String?        @unique

  amount               Decimal
  currency             String         @default("RON")

  donorEmail           String
  donorName            String?
  donorPhone           String?       // Often required by payment processors
  
  isAnonymous          Boolean        @default(false)
  status               String         @default("PENDING") // Changed default to PENDING for flow accuracy
  
  matchedAmount        Decimal        @default(0)
  totalCreditedAmount  Decimal        @default(0) 
  
  sponsor              Sponsor?       @relation(fields: [sponsorId], references: [id])
  sponsorId            String?
  
  matchingRule         MatchingRule?  @relation(fields: [matchingRuleId], references: [id])
  matchingRuleId       String?
  
  // Payer Tracking (who actually paid, regardless of sponsor linkage)
  payerUserId          String?
  payerRole            UserRole?
  invoiceRequested     Boolean        @default(false)
  
  scrisoare            Scrisoare?      @relation(fields: [scrisoareId], references: [id])
  scrisoareId          String?         // Made optional to allow general donations if needed later
  
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([scrisoareId])
  @@index([sponsorId])
  @@index([status])
}

model MonthlySubscription {
  id                   String   @id @default(uuid())
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  stripeSessionId      String?  @unique
  amount               Decimal
  currency             String   @default("RON")
  donorEmail           String   @default("")
  status               String   @default("INCOMPLETE")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
  @@index([donorEmail])
}

model Reservation {
  id                   String   @id @default(uuid())
  stripePaymentIntentId String? @unique
  stripeSessionId      String?  @unique
  amount               Decimal
  expiresAt            DateTime
  status               String   @default("PENDING") 
  scrisoare            Scrisoare @relation(fields: [scrisoareId], references: [id])
  scrisoareId          String
  createdAt            DateTime @default(now())
  @@index([expiresAt])
  @@index([scrisoareId])
}

model ProofMedia {
  id            String      @id @default(uuid())
  url           String
  type          String      
  thumbnailUrl  String?
  moderationStatus String   @default("PENDING") 
  rejectReason     String?
  scrisoare     Scrisoare   @relation(fields: [scrisoareId], references: [id])
  scrisoareId   String
  createdAt     DateTime    @default(now())
}

model FulfillmentClaim {
  id          String    @id @default(uuid())
  status      String    @default("PENDING") 
  expiresAt   DateTime
  donorEmail  String?
  awbProvider String?
  awbNumber   String?
  awbFileUrl  String?
  notes       String?
  scrisoare   Scrisoare @relation(fields: [scrisoareId], references: [id])
  scrisoareId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([scrisoareId])
  @@index([status])
}

model ActionLog {
  id          String   @id @default(uuid())
  actorType   String   
  actorId     String
  actionType  String   
  targetType  String   
  targetId    String
  metadata    String?  
  createdAt   DateTime @default(now())
  @@index([actionType])
  @@index([actorId])
  @@index([targetId])
}

model Update {
  id          String    @id @default(uuid())
  title       String    
  body        String    
  type        String    
  isPublic    Boolean   @default(true)
  scrisoare   Scrisoare? @relation(fields: [scrisoareId], references: [id])
  scrisoareId String?
  createdBy   String?   
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([type])
  @@index([scrisoareId])
  @@index([createdAt])
}

enum RedirectionType {
  INDIVIDUAL_230
  COMPANY_177
}

enum RedirectionStatus {
  DRAFT
  SUBMITTED
  READY_FOR_ANAF
  FILED
  REJECTED
  CONTRACT_SIGNED
  READY_FOR_PAYMENT
  COMPLETED
  CANCELLED
}

enum CompanySponsorshipFlow {
  DIRECT_SPONSORSHIP
  FORM_177
}

enum CompanyTaxRegime {
  PROFIT_TAX
  MICROENTERPRISE
  UNKNOWN
}

enum CompanySponsorshipStatus {
  DRAFT
  CONTRACT_SIGNED
  READY_FOR_PAYMENT
  READY_FOR_ANAF
  FILED
  COMPLETED
  CANCELLED
}

model TaxRedirectionRequest {
  id          String            @id @default(uuid())
  type        RedirectionType
  status      RedirectionStatus @default(DRAFT)
  year        Int

  // Common Contact
  email       String
  phone       String?
  consentTerms Boolean          @default(false)
  consentPrivacy Boolean        @default(false)

  // Individual Form 230
  firstName   String?
  lastName    String?
  fatherInitial String?         // Inițiala tatălui (Form 230)
  cnp         String?           // Ideally encrypted or hashed in code before storing if strictly needed, but for MVP storing plain (or simple encrypt) is common if DB is secure.
  county      String?
  city        String?
  address     String?           // Legacy/full address line
  street      String?
  streetNumber String?
  bloc        String?
  scara       String?
  etaj        String?
  apartament  String?
  postalCode  String?
  
  // Company Form 177
  companyName String?
  cui         String?
  regCom      String?
  contactName String?           // Representative Name
  amountRON   Decimal?

  // Assets
  signatureUrl String?          // S3/Blob URL or Base64 (if small)
  pdfUrl       String?          // Generated Form 230 or Form 177
  contractUrl  String?          // Sponsorship Contract for 177

  anafNotes    String?          // Admin internal notes

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([type])
  @@index([status])
  @@index([year])
  @@index([email])
  @@index([createdAt])
}

model ContractNumberSequence {
  year     Int @id
  lastSeq  Int @default(0)
}

model CompanySponsorshipRequest {
  id        String                   @id @default(uuid())
  flowType  CompanySponsorshipFlow
  status    CompanySponsorshipStatus @default(DRAFT)
  fiscalYear Int

  // Company
  companyName String
  companyCif  String
  regCom      String?
  taxRegime   CompanyTaxRegime       @default(UNKNOWN)

  representativeName String
  representativeRole String?
  email              String
  phone              String?

  // Fiscal domicile
  county      String
  city        String
  street      String
  streetNumber String
  building    String?
  entrance    String?
  floor       String?
  apartment   String?
  postalCode  String?

  // Amounts
  sponsorshipAmount          Decimal?
  maximumRedirectableAmount  Decimal?
  previouslyRedirectedAmount Decimal?
  remainingRedirectableAmount Decimal?
  requestedRedirectAmount    Decimal?

  // Optional Form 177 fiscal period (modified year)
  periodStart DateTime?
  periodEnd   DateTime?

  // Contract
  contractNumber String?   @unique
  contractDate   DateTime?
  contractPdfUrl String?

  // Form 177 draft
  draft177PdfUrl    String?
  disclosureConsent Boolean @default(false)

  // Beneficiary snapshot (at generation time)
  beneficiaryName  String?
  beneficiaryCif   String?
  beneficiaryIban  String?

  // Signature / consents
  signatureUrl   String?
  consentTerms   Boolean @default(false)
  consentPrivacy Boolean @default(false)
  profitTaxConfirm Boolean @default(false)

  anafNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([flowType])
  @@index([status])
  @@index([fiscalYear])
  @@index([email])
  @@index([companyCif])
  @@index([createdAt])
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt     DateTime @default(now())
  @@index([createdAt])
}

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  title     String
  imageUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model SponsorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companyName String?
  cui         String?
  website     String?
  
  // Billing Info for quick access
  billingAddress String?
  billingCity    String?
  billingCui     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Transparent general pot for money redirected from externally fulfilled wishes.
model Fund {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  transactions FundTransaction[]
}

/// Immutable ledger for the general fund (prefer sum of rows over mutable balance).
model FundTransaction {
  id                  String   @id @default(uuid())
  fundId              String
  fund                Fund     @relation(fields: [fundId], references: [id])
  /// external_fulfillment_transfer | fund_allocation_to_letter | late_donation_transfer
  type                String
  /// IN increases available balance; OUT decreases it
  direction           String
  amount              Decimal
  sourceLetterId      String?
  sourceLetter        Scrisoare? @relation("FundSourceLetter", fields: [sourceLetterId], references: [id])
  destinationLetterId String?
  destinationLetter   Scrisoare? @relation("FundDestinationLetter", fields: [destinationLetterId], references: [id])
  note                String?
  publicNote          String?
  createdById         String?
  createdAt           DateTime @default(now())

  /// Optional stable key to prevent duplicate ledger rows (e.g. external_fulfillment:<letterId>).
  idempotencyKey      String?  @unique

  @@index([fundId])
  @@index([type])
  @@index([direction])
  @@index([sourceLetterId])
  @@index([destinationLetterId])
  @@index([createdAt])
}
